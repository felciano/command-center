# Claude Code and MCP configuration
.claude/settings.local.json
CLAUDE.local.md
mcp.json
.mcp.json

# Environment and secrets
.env
.env.local
.env.*.local

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.cer
*.p8

# Dependencies and build artifacts
node_modules/
dist/
dist-extension/
dist-ondemand/
.cc-ondemand-*/
build/
coverage/
.vite/

# The dashboard bundle is regenerated straight into the built appex Resources on
# every native build, so nothing extension-side needs tracking.
*.tsbuildinfo

# Swift / Xcode
DerivedData/
.build/
*.xcuserstate
*.xcworkspace/xcuserdata/
xcuserdata/
*.moved-aside

# OS generated files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Playwright MCP scratch
.playwright-mcp/

# XcodeGen output (project.yml is the source of truth)
native/*.xcodeproj/

# Packaged extension
command-center.zip
dashboard/command-center.zip

# Release artifacts live in the repo-root dist/ but stay local; only the Sparkle
# appcast is committed so the update feed has a tracked history. The broad
# `dist/` rule above still fully ignores dashboard/dist.
!/dist/
/dist/*
!/dist/appcast.xml

# Swift Package Manager local state for the native app.
native/**/.swiftpm/
native/CommandCenterAuth/.build/
